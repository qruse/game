{
  // 전투 프로토타입 웹 빌드 (tools/web/build_web.ps1 이 public/ 을 채운다)
  "name": "project-d20",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // 25 MiB 넘는 파일(gzip)은 R2 에 둔다 (tools/web/deploy_web.ps1)
  "r2_buckets": [
    { "binding": "WEB", "bucket_name": "project-d20-web" }
  ]
}
